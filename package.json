{
  "name": "@adrelle/design-system",
  "private": false,
  "version": "3.3.0",
  "type": "module",
  "main": "dist/css/index.css",
  "files": [
    "dist/css",
    "src/css",
    "!src/css/sandbox.css"
  ],
  "exports": {
    ".": {
      "default": "./dist/css/index.css"
    },
    "./min": "./dist/css/index.min.css",
    "./app.css": {
      "default": "./dist/css/app.css"
    },
    "./app.min.css": "./dist/css/app.min.css",
    "./colors.css": {
      "default": "./dist/css/colors.css"
    },
    "./colors.min.css": "./dist/css/colors.min.css",
    "./src/*": "./src/css/*"
  },
  "scripts": {
    "dev": "vite",
    "build:css": "node scripts/build-css.js",
    "build:sandbox": "vite build",
    "build": "vite build && npm run build:css",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "lightningcss": "^1.32.0",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.1.0"
  }
}
